# Docker Compose по умолчанию запускает собственный PostgreSQL и использует:
# Host=database;Port=5432;Database=popo;Username=popo;Password=popo
#
# Если нужно подключить уже существующий PostgreSQL, укажите полную строку подключения.
# Для базы вне Docker используйте адрес, доступный из контейнера, например host.docker.internal.
# POPO_DB_CONNECTION_STRING=Host=host.docker.internal;Port=5432;Database=popo;Username=popo;Password=<password>
# Если внешняя база находится в уже существующей Docker-сети, дополнительно укажите:
# POPO_DATABASE_NETWORK_EXTERNAL=true
# POPO_DATABASE_NETWORK_NAME=gama_app-network
